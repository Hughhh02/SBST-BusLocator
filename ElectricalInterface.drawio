        <mxCell id="wire_batt_fuse" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;+24V (BATT)&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=3;" edge="1" parent="1" source="battery" target="fuses">
          <mxGeometry relative="1" as="geometry">
