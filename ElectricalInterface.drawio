        <mxCell id="wire_acc_fuse" value="&lt;font color=&quot;#EA580C&quot;&gt;&lt;b&gt;+24V (ACC)&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;dashed=1;" edge="1" parent="1" source="ignition" target="fuses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fuses to DC-DC (+24V Red) -->
        <mxCell id="wire_fuse_dcdc_pwr" value="Fused +24V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=3;entryX=0;entryY=0.25;" edge="1" parent="1" source="fuses" target="dcdc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fuses to DC-DC (ACC Orange) -->
        <mxCell id="wire_fuse_dcdc_acc" value="Fused ACC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;dashed=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="fuses" target="dcdc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Fuses to DC-DC (GND Black) -->
        <mxCell id="wire_fuse_dcdc_gnd" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;entryX=0;entryY=0.75;" edge="1" parent="1" source="fuses" target="dcdc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DC-DC to Jetson -->
        <mxCell id="wire_dcdc_jetson" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Regulated 19V DC &amp;amp; GND&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;exitX=0.5;exitY=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcdc" target="port_pwr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Jetson to Camera (Ethernet) -->
        <mxCell id="wire_eth" value="&lt;font color=&quot;#1E3A8A&quot;&gt;&lt;b&gt;Cat6 Ethernet (Data + PoE)&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1E3A8A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="port_eth" target="camera">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Jetson to Antenna (SMA) -->
