              <Point x="120" y="280" />
              <Point x="120" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Battery to Fuses (GND Black) -->
        <mxCell id="wire_gnd_fuse" value="&lt;b&gt;GND&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="battery" target="fuses">
          <mxGeometry relative="1" as="geometry">
