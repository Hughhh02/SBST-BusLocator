        <mxCell id="publish" value="&lt;b&gt;Publish Payload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Send JSON Coordinates to SBST Backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#991B1B;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="1390" width="240" height="60" as="geometry" />
