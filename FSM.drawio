  <diagram id="software-state-machine" name="IPS Logic State Machine">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= STYLES ================= -->
        <!-- Start/Init Style -->
        <mxCell id="style_init" visible="0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;arcSize=20;" vertex="1" parent="1"/>
        <!-- Process Style -->
        <mxCell id="style_process" visible="0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1"/>
        <!-- Decision Style -->
        <mxCell id="style_decision" visible="0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1"/>
        <!-- Update/Vision Style -->
        <mxCell id="style_update" visible="0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1"/>
        <!-- Map Style -->
        <mxCell id="style_map" visible="0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1"/>
        <!-- Output Style -->
        <mxCell id="style_output" visible="0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#991B1B;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1"/>

        <!-- ================= NODES ================= -->
        
        <!-- INITIALIZATION -->
        <mxCell id="boot" value="&lt;b&gt;System Boot&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="init_map" value="&lt;b&gt;Load Depot Map&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;2D Lookup Table &amp;amp; Topological Graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="init_ekf" value="&lt;b&gt;Initialize State&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Setup EKF Variables [X, Y, Z, Bias=1.0]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- MAIN LOOP DECISION -->
        <mxCell id="loop" value="&lt;b&gt;System&lt;br&gt;Active?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="310" width="100" height="100" as="geometry" />
        </mxCell>

        <mxCell id="shutdown" value="&lt;b&gt;Graceful Shutdown&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- PARALLEL INGESTION -->
        <mxCell id="fetch_tel" value="&lt;b&gt;Poll Stratio API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Extract: Speed, Axles 463/464, Timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="440" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fetch_frame" value="&lt;b&gt;Capture CCTV Frame&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Tag with OS System Timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- VISION PIPELINE -->
        <mxCell id="run_detr" value="&lt;b&gt;Run RF-DETR Inference&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="detect" value="&lt;b&gt;Landmark&lt;br&gt;Detected?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="610" width="120" height="120" as="geometry" />
        </mxCell>

        <!-- STATE 1: KINEMATIC PREDICT (LEFT SIDE) -->
        <mxCell id="kinematics" value="&lt;b&gt;Kinematic Math Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Calculate Differential Yaw &amp;amp; Distance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="640" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ekf_predict" value="&lt;b&gt;EKF Predict Phase&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Push State Forward &amp;amp; Expand Covariance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="730" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="buffer" value="&lt;b&gt;Update Memory Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Save State to Rolling History Buffer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="820" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- STATE 2: VISUAL UPDATE (RIGHT SIDE) -->
        <mxCell id="vision_math" value="&lt;b&gt;Vision Math Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Calculate Pixel-to-Physical Dist &amp;amp; Angle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="750" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lut" value="&lt;b&gt;Query Lookup Table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Retrieve Absolute Depot Coord [X, Y, Z]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="840" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ekf_update" value="&lt;b&gt;EKF Retrospective Update&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1. Rewind Buffer to Frame Timestamp&lt;br&gt;2. Snap to Visual Coordinate (Kill Drift)&lt;br&gt;3. Fast-Forward math to present MS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="930" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bias" value="&lt;b&gt;Calibrate Engine Bias&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Update Kinematic Scale Factor for future states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="1040" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- STATE 3: MAP CONSTRAINTS -->
        <mxCell id="topo" value="&lt;b&gt;Map Constraints Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Snap EKF [X,Y] output to nearest valid Topological Lane&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="1130" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ramp_check" value="&lt;b&gt;Entered&lt;br&gt;Ramp Node?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="1220" width="140" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ramp_state" value="&lt;b&gt;Transition State&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Ignore Z-Math, Follow Ramp Edge Length&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="1250" width="240" height="60" as="geometry" />
        </mxCell>

