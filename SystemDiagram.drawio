<mxfile host="app.diagrams.net" modified="2026-09-18T08:00:00.000Z" agent="Mozilla/5.0" version="24.0.0" type="device">
  <diagram id="sbst-ips-architecture" name="SBST IPS Architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= LAYER 1: DATA SOURCES CONTAINER ================= -->
        <mxCell id="layer1_box" value="&lt;b&gt;LAYER 1: DATA SOURCES &amp;amp; VEHICLE HARDWARE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;fontColor=#475569;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="800" height="130" as="geometry" />
        </mxCell>

        <!-- Stratio Node -->
        <mxCell id="stratio" value="&lt;b&gt;Stratio Predictive API (Cloud)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• ID 114 / 460: Speed&lt;br&gt;• ID 463 &amp;amp; 464: Axle Rotations&lt;br&gt;• ID 267: High-Res Distance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="75" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- Camera Node -->
        <mxCell id="camera" value="&lt;b&gt;Onboard CCTV Camera&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Live RTSP / IP Video Stream&lt;br&gt;• 30 FPS On-Vehicle Perspective&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="75" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- ================= LAYER 2: EDGE COMPUTE CONTAINER ================= -->
        <mxCell id="layer2_box" value="&lt;b&gt;LAYER 2: EDGE COMPUTE (NVIDIA JETSON / ONBOARD LINUX)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F1F5F9;strokeColor=#94A3B8;verticalAlign=top;fontColor=#475569;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="210" width="800" height="480" as="geometry" />
        </mxCell>

        <!-- API Worker -->
        <mxCell id="api_worker" value="&lt;b&gt;API Polling Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Extracts Telemetry &amp;amp; ECU UNIX Timestamps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="250" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Frame Capture -->
        <mxCell id="frame_capture" value="&lt;b&gt;Frame Capture Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Captures &amp;amp; Tags Frames with Local OS Timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="250" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Kinematic Decoder -->
        <mxCell id="kinematics" value="&lt;b&gt;Kinematic Decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Differential Yaw (Axles 463 vs 464)&lt;br&gt;• Linear Velocity (ID 114 / 460)&lt;br&gt;• Continuous Dead Reckoning Output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="345" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- Vision Engine -->
        <mxCell id="vision" value="&lt;b&gt;Vision Engine (RF-DETR)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Static Landmark Detection (Pillars, Berths)&lt;br&gt;• 2D-to-3D Spatial Distance Projection&lt;br&gt;• Queries 2D JSON Lookup Table [X, Y]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="345" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- EKF Core -->
        <mxCell id="ekf" value="&lt;b&gt;Delay-State Extended Kalman Filter (EKF)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• &lt;b&gt;Rolling History Buffer:&lt;/b&gt; Resolves Stratio cloud batch latency&lt;br&gt;• &lt;b&gt;Retrospective Visual Update:&lt;/b&gt; Rewinds state &amp;amp; snaps to visual anchor&lt;br&gt;• &lt;b&gt;Dynamic Bias Calibration:&lt;/b&gt; Online calibration of kinematic scale factor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="465" width="460" height="90" as="geometry" />
        </mxCell>

        <!-- Topological Graph -->
        <mxCell id="graph" value="&lt;b&gt;2D Topological Graph Constraint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Snaps EKF output to drivable depot lanes (eliminates wall clipping)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="595" width="360" height="55" as="geometry" />
        </mxCell>

        <!-- ================= LAYER 3: APPLICATION OUTPUT ================= -->
        <mxCell id="output_node" value="&lt;b&gt;LAYER 3: OUTPUT / SBST FLEET MANAGEMENT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Validated (X, Y) Coordinates (JSON Payload via 4G/5G/Wi-Fi)&lt;br&gt;Depot Fleet Tracking Dashboard &amp;amp; Yard Operations UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="730" width="460" height="65" as="geometry" />
        </mxCell>

        <!-- ================= EDGES & CONNECTORS ================= -->
        <mxCell id="e1" value="Batched Payloads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stratio" target="api_worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="RTSP Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="camera" target="frame_capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Timestamped Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api_worker" target="kinematics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="Timestamped Frames" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frame_capture" target="vision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="Kinematic Deltas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="kinematics" target="ekf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="Visual Anchors [X, Y]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vision" target="ekf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="Fused State" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ekf" target="graph">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="Lane-Constrained Coordinates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="graph" target="output_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
